# ==========================================================
# GymOS Environment Configuration Template (.env.example)
# DO NOT COMMIT YOUR ACTUAL SECRETS (.env) TO VERSION CONTROL
# ==========================================================

# Supabase Credentials (Anon key only - never service role key in frontend)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Razorpay Payment Gateway (Client-side Key ID only - never secret key in frontend)
RAZORPAY_KEY_ID="rzp_test_or_live_key_id"

# Razorpay Subscription Plan IDs
RAZORPAY_STARTER_PLAN_ID="plan_starter_id"
RAZORPAY_PRO_PLAN_ID="plan_pro_id"
RAZORPAY_BUSINESS_PLAN_ID="plan_business_id"

# Display Base URL for Attendance Tablet / Display Mode
DISPLAY_BASE_URL="https://localhost:3000"
